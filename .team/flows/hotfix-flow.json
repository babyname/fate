{
  "components": {
    "roles": [
      {
        "capabilities": [
          "classify",
          "dispatch",
          "assess"
        ],
        "description": "Classify and dispatch hotfix requests",
        "id": "triage",
        "name": "Triage Agent",
        "prompt_directives": [
          "Dispatch tasks to sub-agents, never execute directly",
          "Classify all user input before action: Feature/Bug/Change/Analysis/Batch",
          "Read .team/project.md for project constraints before dispatch",
          "Use flow task create/show for all task state management",
          "Report deliverables and handoff to next role on completion"
        ]
      },
      {
        "capabilities": [
          "implement",
          "test",
          "debug"
        ],
        "description": "Emergency hotfix implementation with minimal scope",
        "id": "dev",
        "name": "Developer",
        "prompt_directives": [
          "Read SCOPE.md before starting implementation",
          "Surgical changes only: never modify files outside task scope",
          "Run tests before marking phase complete",
          "No Chinese comments or commit messages",
          "Never delete files unless explicitly asked",
          "Output Guard 5-step self-check mandatory before completion gate"
        ]
      },
      {
        "capabilities": [
          "verify",
          "test",
          "validate"
        ],
        "description": "Verify hotfix, run smoke tests, validate emergency fix",
        "id": "qa",
        "name": "QA Engineer",
        "prompt_directives": [
          "Verify implementation matches SPEC.md and AC.md",
          "Run full regression tests, not just new tests",
          "Check front-back interface consistency (paths, params, response)",
          "For bugfixes: data flow trace + real scenario verification required",
          "Output Guard self-check before marking review complete"
        ]
      }
    ],
    "rules": [
      {
        "description": "Triage must dispatch tasks to sub-agents, never execute code modifications directly",
        "enforcement": "hard",
        "id": "d1a",
        "instruction": "Triage 必须分发任务给子智能体，禁止自己执行代码修改",
        "name": "Dispatch Guard",
        "source": "builtin",
        "type": "process_constraint"
      },
      {
        "description": "5-step self-assessment before completion gate: deliverable exists, content non-empty, spec compliance, no placeholders, path correctness",
        "enforcement": "hard",
        "id": "d2b",
        "instruction": "完成前必须执行5步自检：产出物存在→内容非空→符合规范→无占位符→路径正确",
        "name": "Output Guard Protocol",
        "source": "framework",
        "type": "process_constraint"
      },
      {
        "description": "Change impact analysis required before code modification; any regression test failure must halt immediately",
        "enforcement": "hard",
        "id": "d3c",
        "instruction": "修改代码前必须执行变更影响分析；任何回归测试失败必须立即停止",
        "name": "Regression Prevention",
        "source": "builtin",
        "type": "quality_constraint"
      },
      {
        "description": "No Chinese comments or commit messages; TDD approach (test first); code must compile",
        "enforcement": "hard",
        "id": "d5f",
        "instruction": "禁止中文注释和提交信息；先写测试再实现；代码必须可编译",
        "name": "Development Standards",
        "source": "builtin",
        "type": "behavioral_constraint"
      },
      {
        "description": "All unit tests must pass; test coverage report required; bug fixes must include regression tests",
        "enforcement": "hard",
        "id": "d6g",
        "instruction": "所有单元测试必须通过；必须有测试覆盖率报告；Bug 修复必须加回归测试",
        "name": "Test Standards",
        "source": "builtin",
        "type": "quality_constraint"
      },
      {
        "description": "Never delete files; never use PowerShell Set-Content/Out-File; never skip toolchain gate",
        "enforcement": "hard",
        "id": "d4e",
        "instruction": "禁止删除文件；禁止用 PowerShell Set-Content/Out-File；禁止跳过工具链门",
        "name": "Hard Constraints",
        "source": "builtin",
        "type": "behavioral_constraint"
      },
      {
        "description": "Before any action, verify assumptions: what assumptions am I acting on? What's the worst case if wrong? What should I clarify first?",
        "enforcement": "hard",
        "id": "qg1",
        "instruction": "行动前验证假设：我在基于什么假设？错了最坏情况？应先澄清什么？",
        "name": "QG-1: Think Before Coding",
        "trigger": "pre_action"
      },
      {
        "description": "Can this be solved with less code? Am I adding unrequested features? Is this over-engineered?",
        "enforcement": "hard",
        "id": "qg2",
        "instruction": "能用更少代码解决吗？在加未要求的功能吗？过度设计了吗？",
        "name": "QG-2: Simplicity First",
        "trigger": "pre_output"
      },
      {
        "description": "Only modify code within task scope. Never optimize or refactor adjacent code. Clean up orphan code from own changes.",
        "enforcement": "hard",
        "id": "qg3",
        "instruction": "只改任务范围内的代码；不优化/重构相邻代码；清理自己产生的孤立代码",
        "name": "QG-3: Surgical Changes",
        "trigger": "code_change"
      },
      {
        "description": "Define success criteria before executing. Each step must have concrete verification criteria. Never use vague 'completed' descriptions.",
        "enforcement": "hard",
        "id": "qg4",
        "instruction": "执行前定义成功标准；每步有具体验证标准；不用模糊的'完成'描述",
        "name": "QG-4: Goal-Driven Execution",
        "trigger": "task_start"
      }
    ],
    "skills": [],
    "tools": [
      {
        "commands": [
          "create",
          "update",
          "close",
          "show",
          "list",
          "ready",
          "append",
          "dep"
        ],
        "id": "task",
        "name": "Task CLI",
        "type": "cli"
      },
      {
        "id": "search",
        "name": "Code Search",
        "type": "builtin"
      },
      {
        "id": "file-ops",
        "name": "File Operations",
        "type": "builtin"
      }
    ]
  },
  "config": {
    "auto_dispatch": true,
    "parallel_limit": 1,
    "task_type": "hotfix",
    "timeout_minutes": 60
  },
  "edges": [
    {
      "from": "phase-triage",
      "id": "e-triage-gate",
      "to": "gate-entry"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-entry",
      "id": "e-gate-fix",
      "to": "phase-fix",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-entry",
      "id": "e-gate-reject",
      "to": "terminal-reject",
      "type": "conditional"
    },
    {
      "from": "phase-fix",
      "id": "e-fix-gate",
      "to": "gate-quality"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-quality",
      "id": "e-gate-verify",
      "to": "phase-verify",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-quality",
      "id": "e-gate-fix-retry",
      "to": "phase-fix",
      "type": "conditional"
    },
    {
      "from": "phase-verify",
      "id": "e-verify-completion",
      "to": "gate-completion"
    },
    {
      "conditions": [
        {
          "expression": "gate.passed"
        }
      ],
      "from": "gate-completion",
      "id": "e-completion-success",
      "to": "terminal-success",
      "type": "conditional"
    },
    {
      "conditions": [
        {
          "expression": "!gate.passed"
        }
      ],
      "from": "gate-completion",
      "id": "e-completion-verify",
      "to": "phase-verify",
      "type": "conditional"
    }
  ],
  "metadata": {
    "author": "team-flow",
    "description": "Emergency hotfix flow: Triage → Gate → Fix → Quality Gate → Verify → Completion Gate → Terminal",
    "name": "hotfix-flow",
    "tags": [
      "hotfix",
      "emergency",
      "software"
    ]
  },
  "nodes": [
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/triage.md",
            "ref": "triage",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "triage",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "d1a",
            "source": "builtin"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "role": "Triage"
      },
      "description": "Classify and validate the emergency hotfix request",
      "docs": [
        {
          "description": "Hotfix triage record with severity assessment, impact scope, and dispatch decision",
          "format": "markdown",
          "name": "TRIAGE.md",
          "path": "{DOCS_INTERNAL}/{task_id}/TRIAGE.md",
          "required": true
        }
      ],
      "id": "phase-triage",
      "name": "Hotfix Triage",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "ready"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "conditions": [
          {
            "type": "task_exists"
          },
          {
            "expected": "hotfix",
            "type": "type_matches"
          }
        ],
        "on_fail": "terminal-reject",
        "on_pass": "phase-fix"
      },
      "description": "Validate hotfix request is genuine emergency",
      "id": "gate-entry",
      "name": "Entry Gate",
      "type": "gate"
    },
    {
      "components": {
        "constraints": [
          {
            "allowed_paths": [
              "{workspace}/"
            ],
            "type": "file_write"
          },
          {
            "minutes": 60,
            "type": "timeout"
          }
        ],
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/dev.md",
            "ref": "dev",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "dev",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "d5f",
            "source": "builtin"
          },
          {
            "ref": "d3c",
            "source": "builtin"
          },
          {
            "ref": "d4e",
            "source": "builtin"
          }
        ],
        "tools": [
          {
            "ref": "task"
          },
          {
            "ref": "search"
          },
          {
            "ref": "file-ops"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "RCA.md",
          "code",
          "regression_tests"
        ],
        "role": "Dev"
      },
      "description": "Implement the emergency hotfix with minimal scope",
      "docs": [
        {
          "content_rules": [
            "Must contain: phenomenon, root_cause, impact, prevention",
            "Data flow trace required for API/permission/state bugs",
            "Real scenario verification required (not mock-only)"
          ],
          "description": "Emergency RCA: incident timeline, root cause, fix description, post-incident actions",
          "format": "markdown",
          "name": "RCA.md",
          "path": "{DOCS_INTERNAL}/{task_id}/RCA.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/bug-test-template.md"
        }
      ],
      "id": "phase-fix",
      "name": "Emergency Fix",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "implement"
        }
      ],
      "on_error": {
        "on_error": [
          {
            "action": "notify",
            "channel": "emergency",
            "message": "Hotfix implementation failed - escalation required"
          }
        ],
        "strategy": "fail"
      },
      "type": "phase"
    },
    {
      "config": {
        "auto_retry": {
          "delay_minutes": 2,
          "max_attempts": 2
        },
        "conditions": [
          {
            "threshold": "100%",
            "type": "tests_pass"
          },
          {
            "threshold": "0 errors",
            "type": "lint_pass"
          },
          {
            "type": "no_regressions"
          },
          {
            "check": "Regression tests added for the fix",
            "required": true,
            "type": "custom"
          },
          {
            "check": "RCA.md contains: phenomenon, root_cause, impact, prevention",
            "required": true,
            "type": "custom"
          },
          {
            "check": "No Chinese comments in code",
            "required": true,
            "type": "custom"
          },
          {
            "check": "Data flow tracing included in RCA",
            "required": true,
            "type": "custom"
          },
          {
            "check": "Real scenario verification passed",
            "required": true,
            "type": "custom"
          }
        ],
        "on_fail": "phase-fix",
        "on_pass": "phase-verify"
      },
      "description": "Verify hotfix passes all tests and no regressions",
      "id": "gate-quality",
      "name": "Quality Gate",
      "type": "gate"
    },
    {
      "components": {
        "prompts": [
          {
            "path": "{TEAM_PATH}/prompts/qa-engineer.md",
            "ref": "qa",
            "source": "file"
          }
        ],
        "roles": [
          {
            "ref": "qa",
            "source": "builtin"
          }
        ],
        "rules": [
          {
            "ref": "d6g",
            "source": "builtin"
          },
          {
            "ref": "d3c",
            "source": "builtin"
          }
        ]
      },
      "config": {
        "auto_dispatch": true,
        "deliverables": [
          "TEST_CASE.md"
        ],
        "role": "QA"
      },
      "description": "Verify the hotfix and produce test case documentation",
      "docs": [
        {
          "content_rules": [
            "Must contain: reproduction steps, expected result, actual result",
            "Smoke test results required for hotfixes"
          ],
          "description": "Test case document for the hotfix including smoke test results",
          "format": "markdown",
          "name": "TEST_CASE.md",
          "path": "{DOCS_INTERNAL}/{task_id}/TEST_CASE.md",
          "required": true,
          "template": "{TEAM_PATH}/templates/bug-test-template.md"
        }
      ],
      "id": "phase-verify",
      "name": "Hotfix Verification",
      "on_enter": [
        {
          "action": "update_task_phase",
          "phase": "verify"
        }
      ],
      "on_exit": [
        {
          "action": "custom",
          "message": "Verify Output Guard 5-step protocol completed",
          "name": "output-guard-check"
        }
      ],
      "type": "phase"
    },
    {
      "config": {
        "conditions": [
          {
            "deliverables": [
              "RCA.md",
              "TEST_CASE.md"
            ],
            "type": "deliverables_complete"
          },
          {
            "threshold": "100%",
            "type": "tests_pass"
          },
          {
            "type": "no_regressions"
          },
          {
            "check": "Output Guard Summary all passed",
            "required": true,
            "type": "custom"
          },
          {
            "check": "User confirmation received",
            "required": true,
            "type": "custom"
          },
          {
            "check": "SCOPE.md generated",
            "required": true,
            "type": "custom"
          }
        ],
        "on_fail": "phase-verify",
        "on_pass": "terminal-success"
      },
      "description": "Final gate verifying all deliverables exist and user confirmation received",
      "id": "gate-completion",
      "name": "Completion Gate",
      "type": "gate"
    },
    {
      "config": {
        "message": "Hotfix flow completed successfully",
        "status": "success"
      },
      "description": "Hotfix completed and verified successfully",
      "id": "terminal-success",
      "name": "Hotfix Applied",
      "on_exit": [
        {
          "action": "custom",
          "message": "Generate handoff document at session end",
          "name": "handoff-doc"
        }
      ],
      "type": "terminal"
    },
    {
      "config": {
        "message": "Hotfix request does not meet emergency criteria",
        "status": "rejected"
      },
      "description": "Hotfix request rejected at entry gate",
      "id": "terminal-reject",
      "name": "Rejected",
      "type": "terminal"
    },
    {
      "config": {
        "message": "Hotfix failed - manual intervention required",
        "status": "failed"
      },
      "description": "Hotfix failed and requires manual escalation",
      "id": "terminal-failed",
      "name": "Escalation Required",
      "type": "terminal"
    }
  ],
  "variables": {
    "DOCS_INTERNAL": "",
    "TEAM_PATH": "",
    "task_id": ""
  },
  "version": "v3"
}
